{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Exile Hub",
  "mainBinaryName": "Exile Hub",
  "version": "../package.json",
  "identifier": "io.github.plaayz.exilehub",
  "build": {
    "frontendDist": "../dist/renderer",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npx vite",
    "beforeBuildCommand": "npx vite build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "dashboard",
        "title": "Exile Hub",
        "url": "index.html?mode=dashboard",
        "width": 1180,
        "height": 780,
        "minWidth": 640,
        "minHeight": 420,
        "visible": false,
        "backgroundColor": "#0e1116",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      },
      {
        "label": "overlay",
        "create": false,
        "title": "Exile Hub overlay",
        "url": "index.html?mode=overlay",
        "width": 440,
        "height": 560,
        "x": 24,
        "y": 24,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "focus": false,
        "focusable": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      },
      {
        "label": "price",
        "create": false,
        "title": "Exile Hub preço",
        "url": "index.html?mode=price",
        "width": 480,
        "height": 640,
        "minWidth": 360,
        "minHeight": 300,
        "visible": false,
        "decorations": false,
        "resizable": true,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "backgroundColor": "#0e1116",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      },
      {
        "label": "trades",
        "create": false,
        "title": "Exile Hub pedidos",
        "url": "index.html?mode=trades",
        "width": 380,
        "height": 160,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "focus": false,
        "focusable": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      },
      {
        "label": "summary",
        "create": false,
        "title": "Exile Hub resumo",
        "url": "index.html?mode=summary",
        "width": 380,
        "height": 250,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVGODAyNkQ4RjQ4RTJERTIKUldUaUxZNzAyQ2FBNzJJUkM1NXZxZlg0cUxNVGlGeWxnZjB5Vmt2U3NENWdsSXhtNGtYdUxyL3EK",
      "endpoints": [
        "https://github.com/PlaaYz/exile-hub/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../data/": "data/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
