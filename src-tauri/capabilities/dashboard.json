{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "dashboard",
  "description": "The dashboard runs the app: windows, tray, clipboard, HTTP to the PoE sites, files through our own commands.",
  "windows": ["dashboard"],
  "permissions": [
    "core:default",
    "allow-app-quit",
    "allow-window-show",
    "allow-window-hide",
    "allow-set-click-through",
    "allow-window-open",
    "allow-window-close",
    "allow-copy-item",
    "allow-focus-game",
    "allow-cursor-pos",
    "allow-clipboard-watch",
    "allow-clipboard-unwatch",
    "allow-send-chat",
    "allow-bring-game-front",
    "allow-app-info",
    "allow-read-data",
    "allow-read-user-file",
    "allow-write-user-file",
    "allow-user-file-age",
    "allow-first-existing",
    "allow-log-tail",
    "allow-log-scan",
    "allow-log-follow",
    "allow-log-unfollow",
    "core:app:allow-default-window-icon",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-ignore-cursor-events",
    "core:tray:default",
    "core:menu:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "dialog:allow-open",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister-all",
    "global-shortcut:allow-unregister",
    "notification:default",
    "autostart:default",
    "updater:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }]
    },
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://www.pathofexile.com/*" },
        { "url": "https://br.pathofexile.com/*" },
        { "url": "https://poe.ninja/*" },
        { "url": "https://raw.githubusercontent.com/*" },
        { "url": "https://pobb.in/*" },
        { "url": "https://pastebin.com/*" }
      ]
    }
  ]
}
